# postopFriend — variables de entorno
# Copie este archivo a .env y complete GROQ_API_KEY. Es la ÚNICA clave obligatoria.
# Obtenga una gratis en https://console.groq.com/keys

# ─── Obligatorio ──────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ─── Modelos (valores por defecto; no hace falta tocarlos) ────────────────────
LLM_MODEL=llama-3.3-70b-versatile
STT_MODEL=whisper-large-v3-turbo
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ─── Solo para reproducir la evaluación completa (opcional) ───────────────────
# Déjelo en `groq`: es la ruta de producción y la que usa la llamada al paciente.
#
# El nivel gratuito de Groq da 100 000 tokens por día y la evaluación del sistema
# completo necesita ~896 000. `openrouter` llega al MISMO modelo servido por el
# MISMO proveedor (Groq), solo que facturado por un intermediario que acepta
# tarjeta; cuesta ~USD 0.55 y corre en un par de horas. Va fijado a Groq sin
# sustitutos y app/agent/llm.py verifica en cada respuesta que el proveedor haya
# sido Groq: si enruta a otro, descarta el resultado en vez de medirlo.
# Compruebe su cuota con `python scripts/cuota_groq.py`.
LLM_BACKEND=groq
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ─── Ruta de prueba: Gemini Flash (opcional) ───────────────────────────────────
# La ruta de producción es `groq`. `gemini` existe para poder comparar con otro
# modelo de la misma familia permitida y medir si el límite lo pone el paciente,
# el extractor o el LLM. Los números de esta comparación están en el informe.
# Coméntelo o póngalo de vuelta en `groq` para entregar.
#LLM_BACKEND=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# `minimal` es lo más bajo que permite la serie 3.x (no se puede apagar del todo).
GEMINI_THINKING=minimal

# ─── Voz ──────────────────────────────────────────────────────────────────────
TTS_BACKEND=edge
TTS_VOICE=es-CO-SalomeNeural
TTS_RATE=+8%

# ─── Triage ───────────────────────────────────────────────────────────────────
# Moduladores de riesgo (comorbilidad, fiebre tardía) de rules.yaml. Apagados
# porque, medidos sobre los 160 casos etiquetados, duplican las falsas alarmas sin
# ganar sensibilidad: 92.5 % de exactitud sin ellos frente a 82.5 % con ellos, y
# recall de rojo del 100 % en ambos casos. Ver `python evals/run_engine_eval.py`.
# Si los enciende, recalibre el corte de rojo a 7 en app/triage/rules.yaml.
TRIAGE_MODULADORES=false

# ─── RAG ──────────────────────────────────────────────────────────────────────
RAG_TOP_K=4
# Umbral de abstención: por debajo de este score el agente declara que no sabe.
RAG_SCORE_MIN=0.34

# ─── Escalamiento ─────────────────────────────────────────────────────────────
# Opcional: URL a la que se hace POST con la alerta (p. ej. un https://webhook.site/...)
ESCALATION_WEBHOOK_URL=

# ─── Servidor ─────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
